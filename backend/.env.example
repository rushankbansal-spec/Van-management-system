# ==========================================
# School Van Tracker - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/school_van_tracker?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256-bits
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_AUDIENCE=school-van-tracker
JWT_ISSUER=school-van-tracker-api

# Password Hashing
# argon2id parameters: memoryCost (KB), timeCost (iterations), parallelism
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVICE_ACCOUNT_FILE=/path/to/firebase-service-account.json
# OR provide individual fields:
# FCM_PROJECT_ID=your-project-id
# FCM_PRIVATE_KEY_ID=your-key-id
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FCM_CLIENT_ID=your-client-id
# FCM_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# FCM_TOKEN_URI=https://oauth2.googleapis.com/token
# FCM_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
# FCM_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40your-project.iam.gserviceaccount.com

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX_AUTH_REQUESTS=5
RATE_LIMIT_MAX_GPS_REQUESTS=20
RATE_LIMIT_MAX_GENERAL=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_REQUEST_ID_HEADER=x-request-id
LOG_SENSITIVE_FIELDS=password,passwordHash,personalIdentifier,nationalId,healthInfo

# Feature Flags
ENABLE_WEB_SOCKET=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_CSV_EXPORT=true

# CORS
CORS_ORIGINS=https://app.schoolvantracker.com
CORS_CREDENTIALS=true

# GPS Tracking
GPS_LOCATION_TTL_SECONDS=300
GPS_BATCH_SIZE=100
GPS_ARCHIVE_INTERVAL_SECONDS=300

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400
ENABLE_IDEMPOTENCY=true

# Trimmed Fields (never log these)
LOG_TRIMMED_FIELDS=password,passwordHash,token,refreshToken,accessToken,apiKey,secret,credential
